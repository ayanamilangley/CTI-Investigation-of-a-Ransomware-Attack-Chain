<Sysmon schemaversion="4.82">
  <!--
    Week 9 Sysmon config for the Black Basta atomic-test lab.
    Small on purpose: it logs ONLY what our Week 9 detection queries need, so the
    logs stay small and the signal is easy to find.

    Why not SwiftOnSecurity (named in our Week 8 plan)? That config leaves the
    ProcessAccess section (Event 10) empty, so it does NOT log access to lsass.exe.
    Our must-detect step D1 (T1003.001) depends on Event 10. This config turns it on,
    using the LSASS access masks from olafhartong/sysmon-modular.

    Install (elevated PowerShell, on the LAB VM only):
        .\Sysmon64.exe -accepteula -i sysmon-week9.xml
    Update later:   .\Sysmon64.exe -c sysmon-week9.xml
    Remove:         .\Sysmon64.exe -u
  -->
  <EventFiltering>

    <!-- Event 1: Process creation. Log everything (small lab). -->
    <RuleGroup name="proc-create" groupRelation="or">
      <ProcessCreate onmatch="exclude"></ProcessCreate>
    </RuleGroup>

    <!-- Event 3: Network. Only the tools our exfil/C2 steps use, to stay quiet. -->
    <RuleGroup name="net" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">rclone.exe</Image>
        <Image condition="end with">powershell.exe</Image>
        <Image condition="end with">curl.exe</Image>
        <Image condition="end with">bitsadmin.exe</Image>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event 10: Process access to LSASS (our D1 / T1003.001). Masks from sysmon-modular. -->
    <RuleGroup name="lsass-access" groupRelation="or">
      <ProcessAccess onmatch="include">
        <Rule groupRelation="and">
          <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
          <GrantedAccess>0x1FFFFF</GrantedAccess>
        </Rule>
        <Rule groupRelation="and">
          <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
          <GrantedAccess>0x1F1FFF</GrantedAccess>
        </Rule>
        <Rule groupRelation="and">
          <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
          <GrantedAccess>0x1010</GrantedAccess>
        </Rule>
        <Rule groupRelation="and">
          <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
          <GrantedAccess>0x1410</GrantedAccess>
        </Rule>
        <Rule groupRelation="and">
          <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
          <GrantedAccess>0x143A</GrantedAccess>
        </Rule>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event 11: File create. Only our staging / dump paths (our E1 / D1). -->
    <RuleGroup name="file-create" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Temp\</TargetFilename>
        <TargetFilename condition="contains">\stage</TargetFilename>
        <TargetFilename condition="contains">\decoy</TargetFilename>
        <TargetFilename condition="contains">patient_records</TargetFilename>
        <TargetFilename condition="end with">.dmp</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Event 13: Registry value set. Only the Run keys (our C1 / T1547.001). -->
    <RuleGroup name="reg-run" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
      </RegistryEvent>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
